{
    "name": "felixmuhoro/laravel-mpesa-wallet",
    "description": "A virtual wallet system for Laravel backed by M-Pesa deposits and withdrawals.",
    "type": "library",
    "keywords": [
        "laravel",
        "mpesa",
        "wallet",
        "mobile-money",
        "kenya"
    ],
    "homepage": "https://github.com/felixmuhoro/laravel-mpesa-wallet",
    "license": "MIT",
    "authors": [
        {
            "name": "Felix Muhoro",
            "email": "hi@felixmuhoro.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "felixmuhoro/laravel-mpesa": "^1.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FelixMuhoro\\MpesaWallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FelixMuhoro\\MpesaWallet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FelixMuhoro\\MpesaWallet\\MpesaWalletServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}